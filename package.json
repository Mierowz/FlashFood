{
  "name": "flashfood",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron": "npm run build && electron .",
    "dist:mac": "npm run build && electron-builder --mac pkg --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:all": "npm run build && electron-builder --mac pkg --win nsis --publish never",
    "dist:mac:x64": "npm run build && electron-builder --mac pkg --x64 --publish never",
    "dist:mac:arm64": "npm run build && electron-builder --mac pkg --arm64 --publish never",
    "dist:mac:universal": "npm run build && electron-builder --mac pkg --universal --publish never"
  },
  "dependencies": {
    "react": "latest",
    "react-dom": "latest",
    "vite": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "electron": "^43.7.9",
    "electron-builder": "latest",
    "vite": "latest"
  },
  "main": "electron.cjs",
  "build": {
    "appId": "com.flashfood.demo",
    "productName": "FlashFood",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron.cjs",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "pkg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "artifactName": "FlashFood-${version}-${arch}.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "FlashFood-Setup-${version}.${ext}"
    },
    "directories": {
      "output": "release"
    }
  }
}
